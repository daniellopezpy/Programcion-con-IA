meta {
  name: 01 - Login Ana
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "ana@example.com",
    "password": "Finanzas2026!"
  }
}

script:post-response {
  bru.setVar("anaToken", res.getBody().token);
}

tests {
  test("Ana inicia sesión", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().token).to.be.a("string");
  });
}
