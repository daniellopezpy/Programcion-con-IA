meta {
  name: 04 - Login Luis
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "luis@example.com",
    "password": "Finanzas2026!"
  }
}

script:post-response {
  bru.setVar("luisToken", res.getBody().token);
}

tests {
  test("Luis inicia sesión", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().token).to.be.a("string");
  });
}
